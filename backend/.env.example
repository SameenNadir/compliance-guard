# ------------------------------------------------------------------
# Enterprise Code Compliance Scanner - Environment Configuration
# ------------------------------------------------------------------
# Copy this file to ".env" and fill in your real keys.
# NEVER commit the real .env file to source control.
# ------------------------------------------------------------------

# Google GenAI (Gemini + text-embedding-004) API key
# Get one at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# Pinecone API key + index name
# Get one at: https://app.pinecone.io (free tier works for this project)
PINECONE_API_KEY=your_pinecone_api_key_here

# Pinecone index name. Create a serverless index named "compliance-rules"
# (or whatever you set here) in the Pinecone console first.
# Recommended dimensions for text-embedding-004: 768
# Metric: cosine
PINECONE_INDEX_NAME=compliance-rules

# Simulated multi-tenancy tenant id. Used for strict metadata filtering.
TENANT_ID=company_a

# Embedding model id (modern Google text embedding model)
EMBEDDING_MODEL=text-embedding-004

# Gemini generative model id for the audit report
GEMINI_MODEL=gemini-2.0-flash
